{
  "name": "catalogo-productos-favoritos-api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de productos y favoritos con Express, SQLite y JWT.",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "db:init": "node scripts/seed.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 test/api.test.js",
    "test:postman": "node scripts/test-postman.js",
    "postman:local": "node scripts/postman-local.js",
    "video": "node scripts/demo-video.js",
    "video:check": "node scripts/demo-video.js --auto",
    "check": "npm test && npm run test:postman"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "newman": "^6.2.3"
  }
}
