# Copiar a .env o ejecutar npm run setup. Nunca publicar .env.
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/catalog.sqlite
# Secreto aleatorio de al menos 32 bytes; npm run setup lo genera localmente.
JWT_SECRET=
JWT_EXPIRES_IN=1h
# Cuenta ficticia creada exclusivamente por npm run db:init.
ADMIN_NAME=Administrador Demo
ADMIN_EMAIL=admin@example.test
# Entre 12 caracteres y 72 bytes UTF-8; dejar vacío en este ejemplo público.
ADMIN_PASSWORD=
